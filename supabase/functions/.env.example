# Defina estes valores em Supabase Dashboard > Edge Functions > Secrets.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
SITE_URL=https://SEU-DOMINIO.com.br
CORS_ALLOWED_ORIGIN=https://SEU-DOMINIO.com.br
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são fornecidos pelo runtime do Supabase.

# WhatsApp Cloud API (Meta). Crie/aprove o template order_tracking (pt_BR)
# com 5 variáveis no corpo: nome, evento, número do pedido, código e link.
WHATSAPP_ACCESS_TOKEN=EAxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_TEMPLATE_NAME=order_tracking

# E-mail via Resend: use um remetente/domínio verificado na conta Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Mercado Jesi <pedidos@SEU-DOMINIO.com.br>
